# ─────────────────────────────────────────────────────────────────────────────
# kungal web (apps/web, Nuxt 4 SSR) — LOCAL DEV env. Copy to apps/web/.env.
#
# Every key below is read by nuxt.config.ts (process.env.*); values point at the
# nextmoe-infra dev stack. The Nuxt dev server runs on 127.0.0.1:2333.
# See ../../nextmoe-infra/docs/dev-environment.md.
# ─────────────────────────────────────────────────────────────────────────────

# Go API base (SSR + browser). The API dev server binds 127.0.0.1:2334.
API_BASE_URL=http://127.0.0.1:2334

# The forum's own public origin (drives sitemap/canonical + cross-app links).
KUN_GALGAME_URL=http://127.0.0.1:2333

# OAuth (NextMoe·未萌 账号 — dev stack).
#   OAUTH_SERVER_URL   : API base for token/HTTP calls (oauth service :9277).
#   OAUTH_FRONTEND_URL : the account-center web app (change email/password jumps).
#                        In dev this is the infra apps/account Nuxt on 127.0.0.1:9420.
#   OAUTH_ADMIN_URL    : the identity CONSOLE, a different app on a different
#                        domain since the 2026-09 rebrand (infra apps/admin,
#                        dev 127.0.0.1:9421). Do not fold it back into
#                        OAUTH_FRONTEND_URL — the account domain has no /users.
#   OAUTH_CLIENT_ID    : the forum's registered client (public dev value; the
#                        browser only ever sends the id + PKCE, never a secret).
OAUTH_SERVER_URL=http://127.0.0.1:9277/api/v1
OAUTH_FRONTEND_URL=http://127.0.0.1:9420
OAUTH_ADMIN_URL=http://127.0.0.1:9421
OAUTH_CLIENT_ID=4ed9bc99ec0a789a4796b83e22bd84c5
OAUTH_REDIRECT_URI=http://127.0.0.1:2333/auth/callback

# image_service public CDN base → the dev stack's read-through proxy (:9290).
# MUST match the Go API's KUN_IMAGE_PUBLIC_BASE_URL exactly (no trailing slash).
IMAGE_CDN_BASE=http://127.0.0.1:9290

# nextmoe-og social card renderer. Off by default: with no key the /og/* routes fall back to
# the static kungalgame.webp, and pages keep advertising that image's real size.
#   NUXT_OG_SITE_KEY            : this site's HMAC key, issued by the og service operator.
#   NUXT_OG_BASE_URL            : the renderer (prod: https://og.nextmoe.dev).
#   NUXT_PUBLIC_OG_CARD_ENABLED : makes pages emit /og/... as their og:image.
# NUXT_OG_SITE_KEY=
# NUXT_OG_BASE_URL=http://127.0.0.1:3300
# NUXT_PUBLIC_OG_CARD_ENABLED=true

# Direct messages on NextMoe chat (/messages). Flip together with the API's
# KUN_CHAT_ENABLED; in production one panel variable feeds both.
# NUXT_PUBLIC_CHAT_ENABLED=true

# Optional analytics / verification (safe to leave empty in dev — nuxt.config has
# literal fallbacks and umami ignores localhost traffic).
# KUN_VISUAL_NOVEL_FORUM_UMAMI_ID=
# KUN_VISUAL_NOVEL_FORUM_YANDEX_VERIFICATION=
